# secrets and per-instance state: never publish these
strata.json
strata.json.*.bak
telemetry/telemetry.json
data/
generated/
backups/
*.db
*.db-shm
*.db-wal
*.log
.env
.private/
.claude/

# third-party Python packages, installed by setup.py (pip install --target vendor -r requirements.txt). Anchored:
# static/vendor/ (CodeMirror and the icon licenses) is part of the repository
/vendor/

__pycache__/
*.pyc

# CodeMirror's readable sources: the dashboard loads only the .min files, which are committed
static/vendor/codemirror/**/*.js
static/vendor/codemirror/**/*.css
!static/vendor/codemirror/**/*.min.js
!static/vendor/codemirror/**/*.min.css

# local sample audio, not part of Strata
static/media/*.mp3
