# Anubis (bot protection) for a single Corium instance. A hardened sample: If Corium is running as root, its “Register” button will write a plainer unit with the same name. 
# Copy this one to /etc/systemd/system/strata-anubis.service and then:
# systemctl daemon-reload && systemctl enable --now strata-anubis
# One unit per Corium instance: change port, the paths and host names. The policy and key are written by corium.
# (Blocklist > Bot protection, or the first Register); Only Anubis can read them. --target is a single space on purpose:
# Anubis does not proxy your files, and responds to Caddy's forward_auth check.
[Unit]
Description=Anubis bot protection for Corium
After=network-online.target
Wants=network-online.target

[Service]
# the user that runs Corium (the key file is readable by that user only)
User=strata
ExecStart=/usr/bin/anubis --bind 127.0.0.1:8923 --target " " \
    --policy-fname /srv/strata/generated/anubis-policy.yaml \
    --ed25519-private-key-hex-file /srv/strata/.private/anubis.key \
    --difficulty 4 --redirect-domains cdn.example.com --slog-level WARN
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
